<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 (Microsoft.Testing.Platform), run as an executable: the Ideafactra verifier runs this assembly directly,
       without network. Keep the default output path. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="1.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.24" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NotDefteri.Api/NotDefteri.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
